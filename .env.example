# Орта: жергілікті жұмыс үшін development, Docker үшін production
APP_ENV=development

# Өндірісте кемінде 16 таңбалы құпиясөз міндетті; мәнді қолмен орнатыңыз
ADMIN_PASSWORD=

# CORS: нақты сайт Origin адресі; бірнеше Origin үтірмен бөлінеді
ALLOWED_ORIGINS=https://dansho09.github.io,http://localhost:8000,http://127.0.0.1:8000

# Ашық өтінімдерге арналған уақытша шектеу (IP сақталмайды)
REQUEST_RATE_LIMIT=5
REQUEST_RATE_WINDOW_SECONDS=600

# Ашық өтінім/қызметкер дерегі үшін міндетті HTTPS құпиялық хабарламасы
PRIVACY_NOTICE_URL=

# Сервер порты және дерекқор жолы
PORT=8000
DB_PATH=./medtekser.db

# Сайттағы байланыс телефоны мен WhatsApp нөмірі
CONTACT_PHONE=+77787961219

# Сайттың сыртқы мекенжайы (Telegram хабарламадағы сілтеме үшін)
PUBLIC_URL=https://dansho09.github.io/medtekser

# Telegram-ға жаңа өтінім туралы хабарлама жіберу (міндетті емес)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
